# Backend API URL (no trailing slash)
NEXT_PUBLIC_API_URL=https://localhost:8443

# Auth.js configuration
# Generate AUTH_SECRET with: npx auth secret
AUTH_SECRET=
# Google OAuth credentials from Google Cloud Console
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Your Azure AD app (client) id for Dataverse + SharePoint sign-in. Needs delegated
# Dynamics CRM user_impersonation and Microsoft Graph Sites.Read.All, admin-consented.
# If unset, a shared demo app is used (which won't have access to your tenant).
NEXT_PUBLIC_MSAL_CLIENT_ID=
