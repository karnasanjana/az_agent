# Fernet encryption key (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FERNET_KEY=

# Gemini Developer API key used by Schema Advisor (server-side only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Server configuration
API_HOST=0.0.0.0
API_PORT=8443

# TLS certificates (relative to backend/)
SSL_KEYFILE=certs/localhost+2-key.pem
SSL_CERTFILE=certs/localhost+2.pem
