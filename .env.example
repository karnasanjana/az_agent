# Copy this file to `.env` and fill in your values.  NEVER commit `.env`.
# Both `uvicorn app:app` and `docker compose up` load `.env` automatically.

# ---------------------------------------------------------------------------
# Claude via Azure AI Foundry  (required for /plan — the BRD parser)
# ---------------------------------------------------------------------------
# Your Foundry resource's Anthropic-compatible endpoint and key.
FOUNDRY_BASE_URL=https://<your-resource>.services.ai.azure.com/anthropic
FOUNDRY_API_KEY=put-your-foundry-key-here
# Model deployment name. Use Sonnet if that's what you deployed:
CLAUDE_MODEL=claude-sonnet-4-6

# ---------------------------------------------------------------------------
# Feature flags
# ---------------------------------------------------------------------------
# MOCK=true  -> local dry-run: /approve writes to mock_tenant/ and simulates the
#               run. No Azure needed. Great for trying the full UI flow.
# MOCK=false -> real Azure build + run (requires the AZURE_* vars below).
MOCK=true
SELF_HEAL=false

# ---------------------------------------------------------------------------
# Azure  (required only when MOCK=false)
# ---------------------------------------------------------------------------
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
ADF_FACTORY_NAME=
ADLS_ACCOUNT_NAME=
# ADLS_ACCOUNT_URL defaults to https://<ADLS_ACCOUNT_NAME>.dfs.core.windows.net
ADLS_ACCOUNT_URL=
AZURE_LOCATION=eastus

# Service principal (omit all three to use `az login` / Managed Identity instead)
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=
